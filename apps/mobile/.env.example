# ---------------------------------------------------------------------------
# MY Warranty — mobile app environment
#
# Copy to `.env.local` (git-ignored) and fill in per environment.
# Only EXPO_PUBLIC_* values are bundled into the app binary. Treat every one of
# them as public: they end up on user devices and can be read from the IPA/APK.
#
# Privileged keys (Supabase service role, model provider keys, Apple/Google
# server credentials) MUST NOT appear here. They belong in Supabase Edge
# Function secrets — see supabase/.env.example.
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development

# Supabase project. The anon key is safe to ship: every table is protected by
# Row Level Security and every privileged action goes through an Edge Function.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Crash + error reporting. Leave blank to disable Sentry entirely.
EXPO_PUBLIC_SENTRY_DSN=

# Legal / support URLs surfaced in Profile and on the paywall. Apple and Google
# both require reachable URLs for a subscription app.
EXPO_PUBLIC_PRIVACY_URL=https://mywarranty.app/privacy
EXPO_PUBLIC_TERMS_URL=https://mywarranty.app/terms
EXPO_PUBLIC_SUPPORT_URL=https://mywarranty.app/support

# Native Google Sign-In client IDs (used by expo-auth-session).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# EAS build project id (set by `eas init`).
EAS_PROJECT_ID=
