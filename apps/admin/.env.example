# Data operations console
#
# Note what is *not* here: SUPABASE_SERVICE_ROLE_KEY. The console talks to the
# database as the signed-in reviewer, using the anon key plus their session, so
# every query and every write is checked by the same RLS policies that protect
# the data from everyone else. A bug in this application cannot hand someone
# more access than their admin_members row grants them.
#
# Admin membership is granted out of band — `admin_members` has no INSERT or
# UPDATE policy, so nothing reachable from a browser can create or elevate one.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
