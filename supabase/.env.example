# ---------------------------------------------------------------------------
# Edge Function secrets — set with `supabase secrets set --env-file .env`
#
# NONE of these may ever appear in the mobile app, in app.config.ts, or in any
# EXPO_PUBLIC_* variable. They are privileged: possession of any one of them is
# enough to read every user's data or to spend money.
# ---------------------------------------------------------------------------

# Injected automatically by the Supabase runtime; listed here for local `supabase serve`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Model provider -------------------------------------------------------
# Used for coverage analysis and receipt field extraction.
ANTHROPIC_API_KEY=
COVERAGE_MODEL=claude-sonnet-5
EXTRACTION_MODEL=claude-haiku-4-5-20251001
EMBEDDING_PROVIDER_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- OCR ------------------------------------------------------------------
# Optional external OCR provider. When unset the pipeline falls back to on-device
# text recognition and the model-based extraction step only.
OCR_PROVIDER_URL=
OCR_PROVIDER_KEY=

# --- Apple App Store ------------------------------------------------------
# App Store Server API key, for receipt verification and server notifications.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.mywarranty.app
# 'Sandbox' or 'Production'
APPLE_ENVIRONMENT=Sandbox

# --- Google Play ----------------------------------------------------------
# Service account JSON (base64) with Android Publisher access.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_PACKAGE_NAME=com.mywarranty.app
# Shared secret used to authenticate Pub/Sub push requests carrying RTDNs.
GOOGLE_RTDN_SHARED_SECRET=

# --- Push -----------------------------------------------------------------
EXPO_ACCESS_TOKEN=

# --- Ops ------------------------------------------------------------------
SENTRY_DSN=
# Shared secret required on the scheduler endpoint, so only pg_cron can invoke it.
SCHEDULER_SECRET=
